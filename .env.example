# Copy to .env and fill in real values. NEVER commit the real .env (rule 01-security).

# Groq LLM (https://console.groq.com/keys)
GROQ_API_KEY=
# Exact model identifier; verify against the current Groq model list.
# Project spec says "Qwen 27B" — closest public id used as placeholder default.
GROQ_MODEL=qwen/qwen3-32b

# Pinecone vector store (https://app.pinecone.io/ — create a serverless index)
# The index must use the cosine metric and dimension 384 (matching the local
# MiniLM-L6-v2 embeddings). If the named index doesn't exist the app creates it.
PINECONE_API_KEY=
PINECONE_INDEX_NAME=internal-docs
# Optional namespace (empty = Pinecone default namespace)
PINECONE_NAMESPACE=
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Directory containing generated test documents
DOCUMENTS_DIR=./documents/generated_test_documents

# Optional JSON seed overriding the built-in demo user registry (ADR-0004):
# [{"user_id": "alice", "display_name": "Alice", "role": "employee"}, ...]
# Roles: employee | hr | manager | executive
ACCESS_CONTROL_SEED_JSON=

# Supabase persistence (ADR-0008): set BOTH to store sessions/messages and the
# user directory in Supabase (create the tables first via supabase/schema.sql).
# Leave blank to use the in-memory stores (dev/test default).
SUPABASE_URL=https://engkkjdtcfooinwnionq.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImVuZ2tramR0Y2Zvb2lud25pb25xIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc4Nzg0NDUyNCwiZXhwIjoyMTAzNDIwNTI0fQ.RzgSEw6Ydjjcr_I8WZc4encvaj6CJ8XcKuuqZV2Q8kw
